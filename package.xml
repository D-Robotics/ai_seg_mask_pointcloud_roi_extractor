<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ai_seg_mask_pointcloud_roi_extractor</name>
  <version>1.0.0</version>
  <description>ROS2 Humble package for filtering depth images based on segmentation masks</description>
  <maintainer email="chen010101chao@163.com">User</maintainer>
  <license>Apache License 2.0</license>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <build_depend>geometry_msgs</build_depend>

  <!-- Dependencies -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>image_transport</depend>
  <depend>pcl_conversions</depend>
  <depend>OpenCV</depend>
  <depend>PCL</depend>
  <depend>libyaml_vendor</depend>
  <depend>fmt</depend>

  <!-- Test dependencies -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>geometry_msgs</exec_depend> 

  <exec_depend>python3-rosidl-runtime-py</exec_depend>
  <exec_depend>python3-rclpy</exec_depend>

  <!-- <member_of_group>rosidl_interface_packages</member_of_group> -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Export -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>